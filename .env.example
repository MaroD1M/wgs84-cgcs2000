# 群晖/本机访问端口（浏览器访问 http://你的IP:这个端口）
APP_PORT=5000

# 镜像版本：
# - latest：最新发布版（推荐默认）
# - 2.0.0：固定版本（镜像标签不带 v）
APP_VERSION=latest

# ── 在线地图预览（天地图）────────────────────────────
# 地图服务：tianditu | none
# v2.0.0 起已移除 OpenStreetMap 和自定义 XYZ 瓦片
MAP_PROVIDER=tianditu

# 天地图浏览器端 Key
# - 留空：部署后在页面“地图设置”中填写，仅当前浏览器生效
# - 填写：所有访问者共用服务端默认 Key
# 请在天地图控制台配置实际访问域名/IP 白名单
TIANDITU_KEY=
